// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE onDelete: Cascade ex. Products should be deleted with category

model User {
  id           Int      @id @default(autoincrement())
  avatar       String?   
  name         String   @unique
  password     String
  createdAt    DateTime @default(now())  
  updatedAt    DateTime @default(now()) @updatedAt
}

// FIXME Add updated at (for editing doc)
model Customer {
  id           Int       @id @default(autoincrement())
  customerCompany String @unique
  incoterm       String
  portOfUnload   String
  creditTerm     String
  currency       String
  address        String
  buyerName      String
  buyerEmail     String    @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  products       Product[]
  shipments      Plan[]
  documents      Document[]
  contacts       Contact[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id           Int       @id @default(autoincrement())
  image        String    @unique
  code         String    @unique
  description  String
  currency     String
  directExchangeRate Decimal @db.Decimal(10, 4) @default(0.0001)
  price        Decimal @db.Decimal(10, 4) @default(0.0001)
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  HSCode       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Plan {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transportationMode String @default("sea-freight")
  POReceive    Int
  load         Int
  transitTime  Int
  due          Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Document {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  courier      String[]
  email        String[]
  driver       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Contact {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transportationMode String 
  freight      String
  shipping     String
  booking      Json
  blOrAwb      Json  
  exportEntry  Json
  form         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model PurchaseOrder {
  id                  Int       @id @default(autoincrement())
  purchaseOrderNumber String
  customerId          Int
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  portOfUnload        String
  status              String
  loading             DateTime @db.Date @default(now())
  ETA                 DateTime @db.Date @default(now())
  note                String
  items               Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}